<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8 to 11: these versions can't tell cloud backup apart from phone-to-phone transfer,
     so nothing is backed up. Use Settings → Backup to save a .numio file instead. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
